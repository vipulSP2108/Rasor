# ==============================================================================
# Google Gemini Configuration (Primary Provider)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# ==============================================================================
# Secondary Model Providers (For multi-model fallback strategy)
# ==============================================================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# Upstream Store API Configuration (Encapsulated in .env)
# ==============================================================================
BEWAKOOF_API_BASE_URL=https://api-prod.your-store-domain.com
BEWAKOOF_COLLECTION_ENDPOINT=/bewakoof-your-collection-path
BEWAKOOF_PDP_ENDPOINT=/bewakoof-product-endpoint
BEWAKOOF_API_TOKEN=your_bewakoof_api_token_here
BEWAKOOF_CLIENT_DEVICE_TOKEN=your_bewakoof_client_device_token_here

# ==============================================================================
# Shopify Headless Storefront & Admin REST Configuration
# ==============================================================================
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token_here
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token_here
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
SHOPIFY_ADMIN_TOKEN=shpat_your_admin_access_token_here
